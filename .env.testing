APP_NAME=starter_app
APP_ENV=testing
# Throwaway key generated for this template; it protects nothing.
APP_KEY=base64:uoC2WWxLUR3lqJp7cIu6uq7SQKHbmr2eJNMtN+vcAgU=
APP_DEBUG=true
APP_URL=http://localhost

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Real Postgres in a dedicated database, never the local dev one.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_app_test
DB_USERNAME=starter_app_app
DB_PASSWORD=starter_app_app_local_only

DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE=starter_app_test
DB_MIGRATOR_USERNAME=starter_app_migrator
DB_MIGRATOR_PASSWORD=starter_app_migrator_local_only

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local
TRUSTED_PROXIES=
