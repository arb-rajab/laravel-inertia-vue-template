APP_NAME=starter_app
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime connection: the ONLY role the running application (web + worker)
# authenticates as. An ordinary role that does NOT own the schema, so it can
# have privileges genuinely revoked (for example UPDATE/DELETE on an
# append-only table) without being able to GRANT them back to itself.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=starter_app
DB_USERNAME=starter_app_app
DB_PASSWORD=starter_app_app_local_only

# Migrator connection: owns the tables and holds BYPASSRLS. Used only by
# `php artisan migrate --database=pgsql_migrator`, seeders and backfills.
# Keep this credential out of the long-running app/worker environment: it
# only protects anything if a compromised app process cannot read it back.
DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE=starter_app
DB_MIGRATOR_USERNAME=starter_app_migrator
DB_MIGRATOR_PASSWORD=starter_app_migrator_local_only

# Redis: queue backend, cache, sessions, login lockout counters.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Cookie flags (Secure, HttpOnly, SameSite=Strict) are set in
# config/session.php. Set SESSION_SECURE_COOKIE=true behind HTTPS.
# SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For/-Host/-Port/-Proto
# and have Laravel believe them, i.e. the reverse proxy actually in front of
# this app, never a wildcard. Leave empty for local `php artisan serve`, where
# $request->ip() must be the real, direct peer. docker-compose.prod.yml sets
# the Docker-internal ranges the web container lives in.
TRUSTED_PROXIES=

# Production only (docker-compose.prod.yml): the domain Caddy serves, for
# automatic HTTPS. Leave unset for plain HTTP on :80.
# SITE_ADDRESS=app.example.com

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
